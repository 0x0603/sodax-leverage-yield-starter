# Everything here is optional. The app works with no .env file.
# Only VITE_-prefixed variables reach the browser bundle.

# WalletConnect (QR / mobile wallets). Injected browser wallets work without it.
# VITE_WALLETCONNECT_PROJECT_ID=

# RPC overrides. Public endpoints are used by default; set these if you hit rate limits.
# VITE_SONIC_RPC_URL=
# VITE_BASE_RPC_URL=
# VITE_ARBITRUM_RPC_URL=
# VITE_OPTIMISM_RPC_URL=
# VITE_POLYGON_RPC_URL=
# VITE_BSC_RPC_URL=
# VITE_AVALANCHE_RPC_URL=
# VITE_ETHEREUM_RPC_URL=
# VITE_HYPEREVM_RPC_URL=

# Base path when deploying under a sub-path (e.g. GitHub Pages: /sodax-leverage-yield-starter/).
# VITE_BASE_PATH=/
